---
// Where the battery's power goes: one thick path to the power hub, then one protected branch for each load.
// Numbers come from src/data/wiring.json (the CAD package's CAN map), so they cannot drift from the tables below it.
import W from '../data/wiring.json';
const motors = W.devices.filter((d) => /Kraken/.test(d.device));
const mpm = W.devices.filter((d) => d.channel.startsWith('MPM'));
const find = (re: RegExp) => W.other.find((o) => re.test(o.load))!;
const amps = (s: string) => s.replace(/ (breaker|fuse)$/, '');
const cam = find(/Limelight/), feed = find(/Mini Power/), rio = find(/roboRIO/), radio = find(/radio/);
const trunk = [
  { name: 'Battery', text: '12 V. Lifts in over the back rail.' },
  { name: 'Battery connector', text: 'The plug you pull to take the battery out.' },
  { name: 'Main breaker', text: '120 A. The robot\'s off switch, on the right rail.' },
  { name: 'Power hub', text: 'Splits the power into 24 channels. Each has its own breaker or fuse.' },
];
const branches = [
  { n: `${motors.length} channels`, prot: `${amps(motors[0].protection)} breaker each`, to: `${motors.length} motors`, text: 'One channel for each motor, on 12 AWG wire.' },
  { n: cam.channel.replace('PDH ', 'Channel '), prot: cam.protection, to: 'Camera', text: 'The Limelight 4.' },
  { n: rio.channel.replace('PDH ', 'Channel '), prot: rio.protection, to: 'roboRIO', text: 'The robot\'s computer.' },
  { n: radio.channel.replace('PDH ', 'Channel '), prot: radio.protection, to: 'Radio', text: '12 V straight to the radio.' },
  { n: feed.channel.replace('PDH ', 'Channel '), prot: feed.protection, to: 'Small power module', text: `Splits again, through 5 A fuses, to ${mpm.length} sensors: the gyro, 4 wheel-angle sensors and 2 distance sensors.` },
];
---

<div class="pp not-content">
  <ol class="trunk" aria-label="The thick wire from the battery to the power hub">
    {trunk.map((t) => <li><strong>{t.name}</strong><span>{t.text}</span></li>)}
  </ol>
  <p class="thick">6 AWG wire, the thickest on the robot, all the way to here</p>
  <ul class="branches" aria-label="What the power hub feeds">
    {branches.map((b) => (
      <li>
        <span class="ch">{b.n}</span>
        <span class="prot">{b.prot}</span>
        <strong>{b.to}</strong>
        <span>{b.text}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .pp {
    margin: 1.5rem 0;
  }
  .trunk,
  .branches {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem 1.25rem;
  }
  .trunk {
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
  }
  .trunk li {
    position: relative;
    display: grid;
    gap: 0.2rem;
    align-content: start;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-bottom: 5px solid var(--sl-color-red);
    border-radius: 0.375rem;
    font-size: var(--sl-text-sm);
    line-height: 1.35;
  }
  .trunk li + li::before {
    content: '→';
    position: absolute;
    left: -1.05rem;
    top: 0.55rem;
    color: var(--sl-color-gray-3);
  }
  .thick {
    margin: 0.35rem 0 0.9rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-align: right;
  }
  .branches {
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
  }
  .branches li {
    display: grid;
    gap: 0.2rem;
    align-content: start;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-top: 3px solid var(--sl-color-red);
    border-radius: 0.375rem;
    font-size: var(--sl-text-sm);
    line-height: 1.35;
  }
  strong {
    color: var(--sl-color-white);
  }
  .ch {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .prot {
    justify-self: start;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 999px;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  .trunk span,
  .branches li > span:last-child {
    color: var(--sl-color-gray-2);
  }
</style>
