---
// A row of numbered steps joined by arrows, for showing a chain of events at a glance.
// It sits above the detail, it does not replace it.
interface Props {
  steps: { title: string; text: string }[];
  label: string;
}
const { steps, label } = Astro.props;
---

<ol class="flow not-content" aria-label={label}>
  {steps.map((s, i) => (
    <li>
      <span class="n">{i + 1}</span>
      <strong>{s.title}</strong>
      <span class="t">{s.text}</span>
    </li>
  ))}
</ol>

<style>
  .flow {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.5rem 1.25rem;
  }
  .flow li {
    position: relative;
    display: grid;
    gap: 0.2rem;
    align-content: start;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-top: 3px solid var(--sl-color-accent);
    border-radius: 0.375rem;
    font-size: var(--sl-text-sm);
    line-height: 1.35;
  }
  .flow li + li::before {
    content: '→';
    position: absolute;
    left: -1.05rem;
    top: 0.55rem;
    color: var(--sl-color-gray-3);
  }
  .n {
    font-size: var(--sl-text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-gray-3);
  }
  .flow strong {
    color: var(--sl-color-white);
  }
  .t {
    color: var(--sl-color-gray-2);
  }
</style>
