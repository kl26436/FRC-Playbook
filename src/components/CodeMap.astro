---
// The robot code on one page: who asks for something, who decides, who moves, and where the code ends
// and the hardware (or the simulator) begins. Boxes link to the page that goes through that part.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
type Box = { name: string; text: string; where: string; href?: string };
const layers: { label: string; note: string; boxes: Box[] }[] = [
  {
    label: 'Who asks',
    note: 'A person or a routine wants something done',
    boxes: [
      { name: 'The driver', text: 'One Xbox controller. Each button starts a command.', where: 'RobotContainer', href: `${base}/code/driving-and-autos/#the-controls` },
      { name: 'An auto', text: 'A list of legs, each one a command.', where: 'autos/', href: `${base}/code/write-an-auto/` },
    ],
  },
  {
    label: 'Commands',
    note: 'One whole job: score, pick up, climb',
    boxes: [
      { name: 'Scoring and pickup', text: 'Drive there, raise on the way, release when lined up, stow.', where: 'commands/ScoreCommands', href: `${base}/code/one-button-to-score/` },
      { name: 'Climbing', text: 'Open the funnel, let the fork down, wind in.', where: 'commands/ClimbCommands' },
    ],
  },
  {
    label: 'Deciders',
    note: 'Turn a job into safe moves',
    boxes: [
      { name: 'Superstructure', text: 'The only part that tells the elevator, wrist and rollers what to do. Enforces the keep-out table.', where: 'subsystems/Superstructure', href: `${base}/code/superstructure/` },
      { name: 'Drive', text: 'Swerve. Drives to a point, or follows the sticks.', where: 'subsystems/drive/', href: `${base}/code/driving-and-autos/` },
      { name: 'Vision', text: 'Corrects the robot\'s position from one reef tag.', where: 'subsystems/vision/', href: `${base}/code/vision/` },
    ],
  },
  {
    label: 'Mechanisms',
    note: 'Each holds a wanted state and a current state',
    boxes: [
      { name: 'Elevator', text: 'Carriage height', where: 'subsystems/elevator/' },
      { name: 'Wrist', text: 'Wrist angle', where: 'subsystems/wrist/' },
      { name: 'Coral rollers', text: 'Take and release coral', where: 'subsystems/coral/' },
      { name: 'Algae claw', text: 'Take and release algae', where: 'subsystems/claw/' },
      { name: 'Climber', text: 'Fork, pawls, funnel latch', where: 'subsystems/climber/' },
    ],
  },
  {
    label: 'The edge of the code',
    note: 'Everything above this line is the same on the robot and in the simulator',
    boxes: [
      { name: 'On the robot', text: 'Motor classes talk to real motor controllers, sensors and the camera.', where: '…IOTalonFX, VisionIOLimelight' },
      { name: 'In the simulator', text: 'The same motor classes, plus physics that moves a pretend robot on a pretend field.', where: '…IOSim, sim/', href: `${base}/code/simulation-and-tests/` },
    ],
  },
];
---

<figure class="codemap not-content">
  {
    layers.map((layer, i) => (
      <div class:list={['layer', { edge: i === layers.length - 1 }]}>
        <div class="side">
          <strong>{layer.label}</strong>
          <span>{layer.note}</span>
        </div>
        <div class="boxes">
          {layer.boxes.map((b) => {
            const Tag = b.href ? 'a' : 'div';
            return (
              <Tag class="box" href={b.href}>
                <strong>{b.name}</strong>
                <span>{b.text}</span>
                <code>{b.where}</code>
              </Tag>
            );
          })}
        </div>
      </div>
    ))
  }
  <div class="shared">
    <div class="box"><strong>Knows the field</strong><span>Where every branch, station, tag and start spot is, for both alliances.</span><code>field/</code></div>
    <div class="box"><strong>Holds the numbers</strong><span>Ports, dimensions, ratios, scoring poses, the keep-out table.</span><code>config/</code></div>
    <p>Used by every layer above. A measurement lives in one place only.</p>
  </div>
  <figcaption>Requests go down the page. Readings come back up. Boxes with an underline open the page that goes through that part.</figcaption>
</figure>

<style>
  .codemap {
    margin: 1.5rem 0;
    display: grid;
    gap: 0;
  }
  .layer {
    position: relative;
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .layer + .layer::before {
    content: '↓';
    position: absolute;
    top: -0.8rem;
    left: 4.2rem;
    padding: 0 0.3rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-3);
    line-height: 1.4;
  }
  .layer.edge {
    border-top: 2px dashed var(--sl-color-accent);
  }
  .side {
    display: grid;
    gap: 0.2rem;
    align-content: start;
    font-size: var(--sl-text-xs);
    line-height: 1.35;
    color: var(--sl-color-gray-3);
  }
  .side strong {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
  }
  .boxes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.5rem;
  }
  .box {
    display: grid;
    gap: 0.25rem;
    align-content: start;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    font-size: var(--sl-text-xs);
    line-height: 1.35;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    background: var(--sl-color-black);
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    overflow-wrap: anywhere;
  }
  .box strong {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
  }
  a.box strong {
    text-decoration: underline;
    text-decoration-color: var(--sl-color-accent);
    text-underline-offset: 0.2em;
  }
  a.box:hover,
  a.box:focus-visible {
    border-color: var(--sl-color-accent);
  }
  .box code {
    justify-self: start;
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
    font-size: 0.7rem;
    padding: 0 0.3rem;
    color: var(--sl-color-gray-3);
    background: transparent;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
  }
  .shared {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.5rem;
    padding: 0.75rem;
    margin-top: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
  }
  .shared p {
    grid-column: 1 / -1;
    margin: 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  @media (max-width: 40rem) {
    .layer {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
    .layer + .layer::before {
      left: 0.5rem;
    }
  }
</style>
