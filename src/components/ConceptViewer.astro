---
// Embeds the interactive concept model from public/concept-viewer/.
// It is the model built for the kickoff brief, kept as a standalone page.
interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = `${base}/concept-viewer/index.html`;
---

<iframe class="concept-viewer not-content" src={src} title={title} loading="lazy"></iframe>

<script>
  // Keep the embedded model in step with the site's light or dark theme, and size the frame to its content.
  for (const frame of document.querySelectorAll<HTMLIFrameElement>('iframe.concept-viewer')) {
    const sync = () => {
      const doc = frame.contentDocument;
      if (!doc?.documentElement) return;
      doc.documentElement.dataset.theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      const height = doc.body ? doc.body.scrollHeight : 0;
      if (height > 0) frame.style.height = `${height}px`;
    };
    const attach = () => {
      sync();
      const doc = frame.contentDocument;
      if (doc?.body && 'ResizeObserver' in window) new ResizeObserver(sync).observe(doc.body);
    };
    frame.addEventListener('load', attach);
    if (frame.contentDocument?.readyState === 'complete') attach();
    new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>

<style>
  .concept-viewer {
    display: block;
    width: 100%;
    height: 820px;
    margin-block: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
  }
</style>
