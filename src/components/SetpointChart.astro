---
// Every named mechanism position in the code as a picture: how high the carriage is and which way the claw
// points. The table of them is on the superstructure page. The numbers come from src/data/control.json (tools/code-pages/make_control_data.py).
import control from '../data/control.json';

const use: Record<string, [string, 'coral' | 'algae' | 'other']> = {
  // the words show when a dot is pointed at; the colour is what is drawn
  STOW: ['Driving, with everything inside the frame', 'other'],
  STATION: ['Taking a coral from the station', 'coral'],
  L1: ['Coral into the trough', 'coral'],
  L2: ['Coral on a level 2 branch', 'coral'],
  L3: ['Coral on a level 3 branch', 'coral'],
  L4: ['Coral on a level 4 branch', 'coral'],
  ALGAE_LOW: ['Algae off the reef, the lower ones', 'algae'],
  ALGAE_HIGH: ['Algae off the reef, the upper ones', 'algae'],
  ALGAE_CARRY: ['Driving with an algae', 'algae'],
  NET: ['Algae into the net', 'algae'],
  PROCESSOR: ['Algae into the processor', 'algae'],
  CLIMB: ['Out of the way for the climb', 'other'],
};
const rows = control.setpoints.map((s) => ({ ...s, what: use[s.name]?.[0] ?? '', kind: use[s.name]?.[1] ?? 'other' }));

const X = (deg: number) => 70 + ((deg + 90) / 165) * 500;
// The scale runs a little below zero so the labels of the low poses have room inside the frame.
const Y = (inches: number) => 400 - ((inches + 9) / 78) * 370;
// Where each label goes, so that none sits on another.
const nudge: Record<string, [number, number, string]> = {
  STOW: [10, -6, 'start'],
  STATION: [-11, 15, 'end'],
  L1: [-11, 4, 'end'],
  L4: [12, 4, 'start'],
  NET: [-12, 4, 'end'],
  CLIMB: [2, 19, 'end'],
  PROCESSOR: [0, 19, 'middle'],
  ALGAE_CARRY: [10, 15, 'start'],
};
---

<div class="sp not-content">
  <figure>
    <svg viewBox="0 0 600 450" role="img" aria-label="The twelve setpoints plotted by wrist angle and carriage height, each with a short line showing which way the claw points">
      <rect x="70" y="30" width="500" height="370" class="frame"></rect>
      {[0, 20, 40, 60].map((h) => (
        <>
          <line x1="70" x2="570" y1={Y(h)} y2={Y(h)} class="grid" />
          <text x="64" y={Y(h) + 4} text-anchor="end" class="axis">{h}</text>
        </>
      ))}
      {[-90, -45, 0, 45, 75].map((d) => (
        <>
          <line x1={X(d)} x2={X(d)} y1="30" y2="400" class="grid" />
          <text x={X(d)} y="416" text-anchor="middle" class="axis">{d > 0 ? '+' : ''}{d}°</text>
        </>
      ))}
      <text x="8" y="20" class="axis">Carriage height, in</text>
      <text x="570" y="438" text-anchor="end" class="axis">Wrist angle: −90° is straight down, 0° is level</text>
      {
        rows.map((r) => {
          const [dx, dy, anchor] = nudge[r.name] ?? [12, 4, 'start'];
          const rad = (r.wristDeg * Math.PI) / 180;
          return (
            <g class={r.kind}>
              <title>{`${r.name}: carriage ${r.carriageIn} in, wrist ${r.wristDeg}°. ${r.what}${r.placeholder ? ' (first guess)' : ''}`}</title>
              <line x1={X(r.wristDeg)} y1={Y(r.carriageIn)} x2={X(r.wristDeg) + 22 * Math.cos(rad)} y2={Y(r.carriageIn) - 22 * Math.sin(rad)} class="arm" />
              <circle cx={X(r.wristDeg)} cy={Y(r.carriageIn)} r="5" class="dot" />
              <text x={X(r.wristDeg) + dx} y={Y(r.carriageIn) + dy} text-anchor={anchor} class="name">{r.name}</text>
            </g>
          );
        })
      }
    </svg>
    <ul>
      <li class="coral"><i></i>coral</li>
      <li class="algae"><i></i>algae</li>
      <li class="other"><i></i>neither</li>
      <li>The short line shows which way the claw points.</li>
    </ul>
  </figure>
</div>

<style>
  .sp {
    margin-block: 1.5rem;
    display: grid;
    gap: 1rem;
  }
  figure {
    margin: 0;
    padding: 0.5rem;
    background: #ffffff;
    color: #0f2029;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .frame {
    fill: #ffffff;
    stroke: #d3dae0;
  }
  .grid {
    stroke: #e3e8ec;
  }
  .axis {
    font-size: 11px;
    fill: #55646e;
  }
  @media (max-width: 40rem) {
    .axis,
    .name {
      font-size: 15px;
    }
  }
  .name {
    font-size: 11px;
    font-weight: 600;
    fill: #0f2029;
  }
  .arm {
    stroke-width: 3;
    stroke-linecap: round;
  }
  .coral .arm,
  .coral .dot {
    stroke: #1846b8;
    fill: #1846b8;
  }
  .algae .arm,
  .algae .dot {
    stroke: #1c7c54;
    fill: #1c7c54;
  }
  .other .arm,
  .other .dot {
    stroke: #55646e;
    fill: #55646e;
  }
  ul {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0 0.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: var(--sl-text-xs);
  }
  li {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  li i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
  }
  li.coral i {
    background: #1846b8;
  }
  li.algae i {
    background: #1c7c54;
  }
  li.other i {
    background: #55646e;
  }
</style>
