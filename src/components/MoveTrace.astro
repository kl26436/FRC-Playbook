---
// One recorded elevator move, stow to L4 and back, from the robot code's simulator: what was asked for, where
// the carriage was, how fast it went and the volts sent to the motors, at every 20 ms loop. Drawn at build time
// from public/replays/elevator_move.json, which the build fetches from the robot code repo.
import { readFileSync } from 'node:fs';
import control from '../data/control.json';

const run = JSON.parse(readFileSync(`${process.cwd()}/public/replays/elevator_move.json`, 'utf8'));
const col = Object.fromEntries(run.columns.map((name: string, i: number) => [name, i]));
const rows: number[][] = run.samples;
const get = (row: number[], name: string) => row[col[name]];
const end = rows[rows.length - 1][0];

// When each new pose was asked for.
const asked: { t: number; pose: string }[] = [];
rows.forEach((row, i) => {
  if (i > 0 && get(row, 'wanted') !== get(rows[i - 1], 'wanted')) asked.push({ t: rows[i - 1][0], pose: run.wanted[get(row, 'wanted')] });
});
const up = rows.filter((row) => run.wanted[get(row, 'wanted')] === 'L4');
const top = control.elevator.softMaxIn;
const tol = control.carriageTolIn;
const outside = up.filter((row) => Math.abs(get(row, 'carriage_in') - top) > tol);
const arrive = outside[outside.length - 1][0] + 0.02 - asked[0].t;
const cruising = up.filter((row) => get(row, 'velocity_in_per_s') > control.elevator.cruiseInPerS - 3).map((row) => get(row, 'volts'));
const cruiseVolts = cruising.reduce((a, b) => a + b, 0) / cruising.length;
const held = up.slice(-20);
const holdVolts = held.reduce((a, row) => a + get(row, 'volts'), 0) / held.length;
const settled = held[held.length - 1][col.carriage_in];
const peak = Math.max(...rows.map((row) => get(row, 'velocity_in_per_s')));
if (!(arrive > 0.8 && arrive < 2 && peak < control.elevator.cruiseInPerS + 8 && Math.abs(settled - top) <= tol))
  throw new Error(`MoveTrace: the recording does not look like a clean move (arrive ${arrive}, peak ${peak}, settled ${settled})`);

const X = (t: number) => 52 + (t / end) * 578;
const panel = (y0: number, h: number, lo: number, hi: number) => (v: number) => y0 + h - ((v - lo) / (hi - lo)) * h;
const Yh = panel(22, 150, 0, 72);
const Yv = panel(206, 110, -130, 130);
const Yu = panel(350, 110, -12, 12);
const line = (name: string, y: (v: number) => number) => rows.map((row) => `${X(row[0]).toFixed(1)},${y(get(row, name)).toFixed(1)}`).join(' ');
// the goal changes in steps, so it is drawn as steps
const steps = rows
  .map((row, i) => (i === 0 ? '' : `${X(row[0]).toFixed(1)},${Yh(get(rows[i - 1], 'goal_carriage_in')).toFixed(1)} `) + `${X(row[0]).toFixed(1)},${Yh(get(row, 'goal_carriage_in')).toFixed(1)}`)
  .join(' ');
const ticks = Array.from({ length: Math.floor(end) + 1 }, (_, i) => i);
const panels = [
  { y: 22, h: 150, label: 'Height, in', marks: [0, 20, 40, 60], f: Yh },
  { y: 206, h: 110, label: 'Speed, in/s', marks: [-110, 0, 110], f: Yv },
  { y: 350, h: 110, label: 'Volts', marks: [-10, 0, 10], f: Yu },
];
---

<figure class="trace not-content">
  <svg viewBox="0 0 640 490" role="img" aria-label={`A recorded elevator move from stow to L4 and back: height against its goal, speed, and volts. It reaches L4 ${arrive.toFixed(2)} seconds after being asked, cruises on ${cruiseVolts.toFixed(1)} volts and holds on ${holdVolts.toFixed(2)} volts.`}>
    {panels.map((p) => (
      <>
        <rect x="52" y={p.y} width="578" height={p.h} class="frame" />
        <text x="52" y={p.y - 6} class="axis">{p.label}</text>
        {p.marks.map((m) => (
          <>
            <line x1="52" x2="630" y1={p.f(m)} y2={p.f(m)} class={m === 0 ? 'zero' : 'grid'} />
            <text x="46" y={p.f(m) + 4} text-anchor="end" class="axis">{m}</text>
          </>
        ))}
        {ticks.map((t) => <line x1={X(t)} x2={X(t)} y1={p.y} y2={p.y + p.h} class="grid" />)}
        {asked.map((a) => <line x1={X(a.t)} x2={X(a.t)} y1={p.y} y2={p.y + p.h} class="ask" />)}
      </>
    ))}
    {ticks.map((t) => <text x={X(t)} y="476" text-anchor="middle" class="axis">{t}</text>)}
    <text x="630" y="488" text-anchor="end" class="axis">seconds</text>
    {asked.map((a) => <text x={X(a.t) + 5} y="36" class="say">{a.pose === 'L4' ? 'L4 asked for' : 'stow asked for'}</text>)}
    <polyline points={steps} class="goal" />
    <polyline points={line('carriage_in', Yh)} class="pos" />
    <polyline points={line('velocity_in_per_s', Yv)} class="speed" />
    <polyline points={line('volts', Yu)} class="volts" />
  </svg>
  <ul>
    <li><i class="k-goal"></i>the goal the planner sent on each loop</li>
    <li><i class="k-pos"></i>where the carriage was</li>
    <li><i class="k-speed"></i>its speed</li>
    <li><i class="k-volts"></i>volts to the motors</li>
  </ul>
  <figcaption>
    Simulated, with a coral aboard, at every 20 ms loop (commit {run.code}). Inside {tol} in of L4 {arrive.toFixed(2)} s after it was asked for.
    Fastest: {peak.toFixed(0)} in/s. About {cruiseVolts.toFixed(1)} V at cruise and {holdVolts.toFixed(2)} V to hold at the top, where it settled at {settled} in.
  </figcaption>
</figure>

<style>
  .trace {
    margin: 1.5rem 0;
    padding: 0.5rem;
    background: #ffffff;
    color: #0f2029;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .frame {
    fill: #ffffff;
    stroke: #d3dae0;
  }
  .grid {
    stroke: #e3e8ec;
  }
  .zero {
    stroke: #aab4bc;
  }
  .ask {
    stroke: #55646e;
    stroke-dasharray: 3 3;
  }
  .axis {
    font-size: 11px;
    fill: #55646e;
  }
  .say {
    font-size: 11px;
    font-weight: 600;
    fill: #0f2029;
  }
  @media (max-width: 40rem) {
    .axis,
    .say {
      font-size: 16px;
    }
  }
  polyline {
    fill: none;
    stroke-linejoin: round;
  }
  .goal {
    stroke: #1c7c54;
    stroke-width: 1.5;
  }
  .pos {
    stroke: #0f2029;
    stroke-width: 2.5;
  }
  .speed {
    stroke: #1846b8;
    stroke-width: 2;
  }
  .volts {
    stroke: #c77700;
    stroke-width: 2;
  }
  ul {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0 0.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: var(--sl-text-xs);
  }
  li {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  li i {
    width: 1.25rem;
    border-top: 3px solid #0f2029;
  }
  li i.k-goal {
    border-color: #1c7c54;
  }
  li i.k-speed {
    border-color: #1846b8;
  }
  li i.k-volts {
    border-color: #c77700;
  }
  figcaption {
    margin: 0.5rem 0.25rem 0.25rem;
    font-size: var(--sl-text-xs);
    color: #55646e;
  }
</style>
