---
// Every channel of the power hub and what plugs into it, coloured by the part of the robot it feeds.
// Drawn in number order. It is a list you can see at a glance, not a picture of the hub.
import W from '../data/wiring.json';
const SHORT: Record<number, string> = {
  11: 'Front left drive', 12: 'Front left steer', 21: 'Front right drive', 22: 'Front right steer', 31: 'Back left drive', 32: 'Back left steer',
  41: 'Back right drive', 42: 'Back right steer', 51: 'Lift, left', 52: 'Lift, right', 53: 'Wrist', 54: 'Coral rollers', 55: 'Claw front',
  56: 'Claw rear', 57: 'Climber, left', 58: 'Climber, right',
};
const group = (id: number) => (id < 50 ? 'drive' : id <= 52 ? 'lift' : id <= 56 ? 'wrist' : 'climb');
type Cell = { n: number; label: string; prot: string; g: string; id?: number };
const cells: Cell[] = Array.from({ length: 24 }, (_, n) => ({ n, label: 'Spare', prot: '', g: 'spare' }));
for (const d of W.devices) {
  if (!/^\d+$/.test(d.channel)) continue;
  if (!SHORT[d.id]) throw new Error('PdhMap: no short name for CAN ID ' + d.id);
  cells[+d.channel] = { n: +d.channel, label: SHORT[d.id], prot: d.protection, g: group(d.id), id: d.id };
}
for (const o of W.other) {
  const m = o.channel.match(/^PDH (\d+)(?:, (\d+))?( \(switched\))?$/);
  if (!m) continue;
  for (const s of [m[1], m[2]].filter(Boolean)) {
    const spare = /^spare/.test(o.load);
    cells[+s] = { n: +s, label: spare ? (m[3] ? 'Spare, switched' : 'Spare') : o.load.split(',')[0].replace(' feed', '').replace(' VH-109', '').replace(/^radio/, 'Radio'), prot: spare ? '' : o.protection, g: spare ? 'spare' : 'ctrl' };
  }
}
const KEY = [['drive', 'Swerve'], ['lift', 'Elevator'], ['wrist', 'Wrist and claw'], ['climb', 'Climber'], ['ctrl', 'Control and sensors'], ['spare', 'Spare']];
const used = cells.filter((c) => c.g !== 'spare').length;
---

<figure class="pdh not-content">
  <ol>
    {cells.map((c) => (
      <li class={c.g}>
        <span class="n">{c.n}</span>
        <strong>{c.label}</strong>
        {c.prot && <span class="p">{c.prot.replace(' breaker', '').replace(' fuse', ' fuse')}{c.id ? ` · ID ${c.id}` : ''}</span>}
      </li>
    ))}
  </ol>
  <figcaption>
    <span class="key">{KEY.map(([g, t]) => <span class={g}><i></i>{t}</span>)}</span>
    {used} of 24 channels are used. This is in number order, not the way the hub is laid out. Read the numbers printed on the hub.
  </figcaption>
</figure>

<style>
  .pdh {
    margin: 1.5rem 0;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.4rem, 1fr));
    gap: 0.4rem;
  }
  .pdh {
    --c: var(--sl-color-gray-4);
  }
  .pdh .drive { --c: #5b6b78; }
  .pdh .lift { --c: #2f7fd1; }
  .pdh .wrist { --c: #e07b1f; }
  .pdh .climb { --c: #b04fc2; }
  .pdh .ctrl { --c: #d8b21f; }
  li {
    display: grid;
    gap: 0.1rem;
    align-content: start;
    min-height: 4.6rem;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-left: 5px solid var(--c);
    border-radius: 0.375rem;
    font-size: var(--sl-text-xs);
    line-height: 1.3;
  }
  li.spare {
    border-style: dashed;
    border-left-style: dashed;
    color: var(--sl-color-gray-3);
  }
  .n {
    font-size: var(--sl-text-lg);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-white);
    line-height: 1.1;
  }
  li strong {
    color: var(--sl-color-gray-1);
    font-weight: 600;
  }
  li.spare strong {
    color: var(--sl-color-gray-3);
    font-weight: 400;
  }
  .p {
    color: var(--sl-color-gray-3);
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    margin-bottom: 0.3rem;
    color: var(--sl-color-gray-2);
  }
  .key span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .key i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
    background: var(--c);
  }
  .key .spare i {
    background: none;
    border: 1px dashed var(--sl-color-gray-3);
  }
</style>
